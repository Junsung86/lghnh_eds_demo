# Copy to .env (never commit it). Values come from the Adobe Developer Console project.
# OAuth Server-to-Server credential of the technical account
IMS_CLIENT_ID=
IMS_CLIENT_SECRET=
IMS_SCOPES=openid,AdobeID,read_organizations
# aem.live admin API key for previewing pages (optional if the technical account is a site admin)
HLX_ADMIN_API_KEY=
